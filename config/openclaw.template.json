{
  "agents": {
    "defaults": {
      "model": {
        "primary": "strata/{{STRATA_MODEL_ID}}"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "tailscale": {
      "mode": "off"
    }
  },
  "tools": {
    "profile": "coding",
    "web": {
      "search": {
        "provider": "searxng",
        "enabled": true
      }
    },
    "toolSearch": {
      "mode": "tools"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "strata": {
        "baseUrl": "http://127.0.0.1:8080/v1",
        "api": "openai-completions",
        "apiKey": "strata-local",
        "timeoutSeconds": 900,
        "models": [
          {
            "id": "{{STRATA_MODEL_ID}}",
            "name": "Strata Qwen3.8 Flash Next ({{STRATA_MODEL_LABEL}})",
            "contextWindow": 262144,
            "maxTokens": 16384,
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          }
        ]
      }
    }
  },
  "memory": {
    "search": {
      "provider": "local"
    }
  },
  "plugins": {
    "entries": {
      "searxng": {
        "config": {
          "webSearch": {
            "baseUrl": "http://127.0.0.1:8890"
          }
        }
      }
    }
  }
}
